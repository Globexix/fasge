use "engine/sdl.fas"

var rect_dx i32 = 1
var steps i32 = 0
var steps_text arr[4, u8] = {'0', '0', '0', 0}

fn game_init() void {
    gpu.bg = 0x25

    gpu.rects[0].x0 = 10
    gpu.rects[0].y0 = 43
    gpu.rects[0].x1 = 19
    gpu.rects[0].y1 = 52
    gpu.rects[0].color = 0xf5
    gpu.rects[0].enable = 1

    text_print(0, 0, c"STEPS: ", 0xfc)
    text_print(6, 0, &steps_text, 0xff)

    present()
}

fn game_update() void {
    view rect = gpu.rects[0]

    if btn(1) && rect.y0 > 0 {
        rect.y0 -= 1
        rect.y1 -= 1
        steps += 1
    } else if btn(2) && rect.y1 < SCREEN_H - 1 {
        rect.y0 += 1
        rect.y1 += 1
        steps += 1
    }

    if btn(4) && rect.x1 < SCREEN_W - 1 {
        rect.x0 += 1
        rect.x1 += 1
        steps += 1
    } else if btn(8) && rect.x0 > 0 {
        rect.x0 -= 1
        rect.x1 -= 1
        steps += 1
    }

    steps_text[2] = trunc[u8]('0' + steps % 10)
    steps_text[1] = trunc[u8]('0' + (steps / 10) % 10)
    steps_text[0] = trunc[u8]('0' + (steps / 100) % 10)

    text_print(6, 0, &steps_text, 0xff)

    present()
}
