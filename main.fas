use "engine/sdl.fas"

var rect_dx i32 = 1

fn game_init() void {
    gpu.bg = 0x25

    gpu.rects[0].x0 = 10
    gpu.rects[0].y0 = 43
    gpu.rects[0].x1 = 19
    gpu.rects[0].y1 = 52
    gpu.rects[0].color = 0xf5
    gpu.rects[0].enable = 1

    present()
}

fn game_update() void {
    view rect = gpu.rects[0]

    if btn(1) && rect.y0 > 0 {
        rect.y0 -= 1
        rect.y1 -= 1
    } else if btn(2) && rect.y1 < SCREEN_H - 1 {
        rect.y0 += 1
        rect.y1 += 1
    }

    if btn(4) && rect.x1 < SCREEN_W - 1 {
        rect.x0 += 1
        rect.x1 += 1
    } else if btn(8) && rect.x0 > 0 {
        rect.x0 -= 1
        rect.x1 -= 1
    }

    present()
}
