use pkg "sdl"
// SDL.h pulls in stdlib.h whose random() clashes with fas definition
use "C" <<C
    #define random libc_random
C
use "C" <SDL.h>
use "C" <time.h>
use "raster.fas"

const SCREEN_SCALE i32 = 5

const SDL_KEYS arr[6, i32] = {
    SDLK_UP, SDLK_DOWN, SDLK_RIGHT, SDLK_LEFT,
    SDLK_RETURN,
    SDLK_1
}

// one key per button, in bit order
fn sdl_read_buttons(keys addr) i32 {
    bits i32 = 0
    for i usize = 0; i < len(SDL_KEYS); i += 1 {
        if keys[u8, SDL_KEYS[i]] != 0 { bits = bits | (1 << i) }
    }
    return bits
}

var sdl_colors arr[256, u32] = {}

// RGB332
fn sdl_palette(format handle[SDL_PixelFormat]) void {
    for i usize = 0; i < len(sdl_colors); i += 1 {
        rgb u32 = trunc[u32](((((i >> 5) & 7) * 73) >> 1) << 16 | ((((i >> 2) & 7) * 73) >> 1) << 8 | (i & 3) * 85)
        if i == 0 { rgb = 0 }                   // zero is always black
        sdl_colors[i] = SDL_MapRGB(format, trunc[u8](rgb >> 16), trunc[u8](rgb >> 8), trunc[u8](rgb))
    }
}

fn sdl_compose(screen handle[SDL_Surface]) void {
    compose()

    view surf = handle_addr(screen)[SDL_Surface]
    sdl_palette(surf.format)
    SDL_LockSurface(screen)
    for y i32 = 0; y < SCREEN_H * SCREEN_SCALE; y += 1 {
        line addr = surf.pixels + y * zext[i32](surf.pitch)
        src usize = bitcast[u32]((y / SCREEN_SCALE) * SCREEN_W)
        for x i32 = 0; x < SCREEN_W * SCREEN_SCALE; x += 1 {
            line[u32, x] = sdl_colors[indices[src + bitcast[u32](x / SCREEN_SCALE)]]
        }
    }
    SDL_UnlockSurface(screen)
    SDL_Flip(screen)
}

var latched Gpu = {}

var sdl_ticks u32 = 0

fn present() void {
    copy(latched, gpu)
}

fn now_ticks() i32 {
    return bitcast[i32](sdl_ticks)
}

fn load_start() void {}
fn load_done() void {}

var random_state u32 = 0

// xorshift32, seeded from the wall clock on the first call. never negative
fn random() i32 {
    if random_state == 0 { random_state = trunc[u32](bitcast[u64](time(null))) ^ 0x9e3779b9 }
    if random_state == 0 { random_state = 1 }
    random_state = random_state ^ (random_state << 13)
    random_state = random_state ^ (random_state >> 17)
    random_state = random_state ^ (random_state << 5)
    return bitcast[i32](random_state >> 1)
}

// box is [x0, x1) x [y0, y1) in cells, packed as 6 bit fields like the hardware register
fn text_fill(x0 i32, y0 i32, x1 i32, y1 i32, word i32) void {
    gpu.text_fill = word
    gpu.text_box = (x0 & 63) | (y0 & 63) << 6 | (x1 & 63) << 12 | (y1 & 63) << 18
    for row i32 = clamp(y0, 0, TEXT_ROWS); row < clamp(y1, 0, TEXT_ROWS); row += 1 {
        for col i32 = clamp(x0, 0, TEXT_COLS); col < clamp(x1, 0, TEXT_COLS); col += 1 {
            gpu.text[row * TEXT_COLS + col] = word
        }
    }
}

fn main() i32 {
    if SDL_Init(bitcast[u32](SDL_INIT_VIDEO)) != 0 { return 1 }
    defer { SDL_Quit() }

    screen handle[SDL_Surface] = SDL_SetVideoMode(SCREEN_W * SCREEN_SCALE, SCREEN_H * SCREEN_SCALE, 32, bitcast[u32](SDL_SWSURFACE))
    if screen == null { return 2 }

    build_yaw_table()
    game_init()

    start u32 = SDL_GetTicks()
    ev SDL_Event = {}

    while running {
        while SDL_PollEvent(&ev) != 0 {
            if ev.type == SDL_QUIT { quit() }
        }
        keys addr = SDL_GetKeyState(null)
        if keys[u8, SDLK_ESCAPE] != 0 || keys[u8, SDLK_j] != 0 { quit() }
        if !running { break }

        sdl_ticks += 1
        if sdl_ticks % bitcast[u32](clamp(frame_ticks, 1, 60)) == 0 {
            tick += 1
            buttons_prev = buttons
            buttons = sdl_read_buttons(keys)
            game_update()
            sdl_compose(screen)
        }

        target u64 = zext[u64](sdl_ticks) * 1000 / 60
        while zext[u64](SDL_GetTicks() - start) < target { SDL_Delay(1) }
    }

    return 0
}
