use pkg "sdl"
use "C" <SDL.h>
use "C" <stdio.h>
use "raster.fas"

const SCREEN_SCALE i32 = 5

const SDL_KEYS arr[7, i32] = {
    SDLK_UP, SDLK_DOWN, SDLK_RIGHT, SDLK_LEFT,
    SDLK_RETURN,
    SDLK_1, SDLK_2
}

fn sdl_read_buttons(keys addr) i32 {
    bits i32 = 0
    for i usize = 0; i < len(SDL_KEYS); i += 1 {
        if keys[u8, SDL_KEYS[i]] != 0 { bits = bits | (1 << i) }
    }
    return bits
}

var sdl_colors arr[256, u32] = {}

fn sdl_palette(format handle[SDL_PixelFormat]) void {
    custom bool = false
    for i usize = 0; i < len(latched.palette); i += 1 {
        if latched.palette[i] != 0 { custom = true }
    }
    for i usize = 0; i < len(sdl_colors); i += 1 {
        rgb u32 = bitcast[u32](latched.palette[i])
        if !custom {
            // RGB332
            rgb = trunc[u32](((((i >> 5) & 7) * 73) >> 1) << 16 | ((((i >> 2) & 7) * 73) >> 1) << 8 | (i & 3) * 85)
        }
        if i == 0 { rgb = 0 }                   // zero is always black
        sdl_colors[i] = SDL_MapRGB(format, trunc[u8](rgb >> 16), trunc[u8](rgb >> 8), trunc[u8](rgb))
    }
}

fn sdl_compose(screen handle[SDL_Surface]) void {
    compose()

    view surf = handle_addr(screen)[SDL_Surface]
    sdl_palette(surf.format)
    SDL_LockSurface(screen)
    for y i32 = 0; y < SCREEN_H * SCREEN_SCALE; y += 1 {
        line addr = surf.pixels + y * zext[i32](surf.pitch)
        src usize = bitcast[u32]((y / SCREEN_SCALE) * SCREEN_W)
        for x i32 = 0; x < SCREEN_W * SCREEN_SCALE; x += 1 {
            line[u32, x] = sdl_colors[indices[src + bitcast[u32](x / SCREEN_SCALE)]]
        }
    }
    SDL_UnlockSurface(screen)
    SDL_Flip(screen)
}

var latched Gpu = {}

fn present() void {
    copy(latched, gpu)
}

fn main() i32 {
    if SDL_Init(bitcast[u32](SDL_INIT_VIDEO)) != 0 { return 1 }
    defer { SDL_Quit() }

    screen handle[SDL_Surface] = SDL_SetVideoMode(SCREEN_W * SCREEN_SCALE, SCREEN_H * SCREEN_SCALE, 32, bitcast[u32](SDL_SWSURFACE))
    if screen == null { return 2 }

    build_yaw_table()
    game_init()

    start u32 = SDL_GetTicks()
    ev SDL_Event = {}
    compose_ms u32 = 0

    while running {
        while SDL_PollEvent(&ev) != 0 {
            if ev.type == SDL_QUIT { running = false }
        }
        keys addr = SDL_GetKeyState(null)
        if keys[u8, SDLK_ESCAPE] != 0 { running = false }
        if !running { break }

        tick += 1
        if tick % 6 == 0 {
            buttons_prev = buttons
            buttons = sdl_read_buttons(keys)
            t0 u32 = SDL_GetTicks()
            game_update()
            t1 u32 = SDL_GetTicks()
            sdl_compose(screen)
            compose_ms += SDL_GetTicks() - t1
        }

        target u64 = zext[u64](tick) * 1000 / 60
        while zext[u64](SDL_GetTicks() - start) < target { SDL_Delay(1) }
    }

    return 0
}
