use "C" <SDL.h>
use "core.fas"

var sdl_colors arr[256, u32] = {}

const SCREEN_SCALE i32 = 5

const SDL_KEYS arr[15, i32] = {
    SDLK_UP, SDLK_DOWN, SDLK_RIGHT, SDLK_LEFT,
    SDLK_RETURN,
    SDLK_1, SDLK_2, SDLK_3, SDLK_4, SDLK_5, SDLK_6, SDLK_7, SDLK_8, SDLK_9, SDLK_0,
}

fn sdl_read_buttons(keys addr) i32 {
    bits i32 = 0
    for i usize = 0; i < len(SDL_KEYS); i += 1 {
        if keys[u8, SDL_KEYS[i]] != 0 { bits = bits | (1 << i) }
    }
    return bits
}

fn sdl_pixel(x i32, y i32) i32 {
    color i32 = latched.bg
    for slot usize = 0; slot < len(latched.rects); slot += 1 {
        view rect = latched.rects[slot]
        if rect.enable != 0 && x >= rect.x0 && x <= rect.x1 && y >= rect.y0 && y <= rect.y1 {
            color = rect.color
        }
    }
    return color
}

fn sdl_compose(screen handle[SDL_Surface]) void {
    for y i32 = 0; y < SCREEN_H; y += 1 {
        for x i32 = 0; x < SCREEN_W; x += 1 {
            index i32 = sdl_pixel(x, y) & 255
            rect SDL_Rect = {trunc[i16](x * SCREEN_SCALE), trunc[i16](y * SCREEN_SCALE), trunc[u16](SCREEN_SCALE), trunc[u16](SCREEN_SCALE)}
            SDL_FillRect(screen, &rect, sdl_colors[index])
        }
    }
    SDL_Flip(screen)
}

fn main() i32 {
    if SDL_Init(bitcast[u32](SDL_INIT_VIDEO)) != 0 { return 1 }
    defer { SDL_Quit() }

    screen handle[SDL_Surface] = SDL_SetVideoMode(SCREEN_W * SCREEN_SCALE, SCREEN_H * SCREEN_SCALE, 32, bitcast[u32](SDL_SWSURFACE))
    if screen == null { return 2 }

    view surf = handle_addr(screen)[SDL_Surface]

    // RGB332 palette. zero is always black
    for index usize = 0; index < len(sdl_colors); index += 1 {
        r u8 = trunc[u8]((((index >> 5) & 7) * 73) >> 1)
        g u8 = trunc[u8]((((index >> 2) & 7) * 73) >> 1)
        b u8 = trunc[u8]((index & 3) * 85)
        sdl_colors[index] = SDL_MapRGB(surf.format, r, g, b)
    }
    game_init()

    start u32 = SDL_GetTicks()
    ev SDL_Event = {}

    while running {
        while SDL_PollEvent(&ev) != 0 {
            if ev.type == SDL_QUIT { running = false }
        }
        keys addr = SDL_GetKeyState(null)
        if keys[u8, SDLK_ESCAPE] != 0 { running = false }
        if !running { break }

        tick += 1
        if tick % 6 == 0 {
            buttons_prev = buttons
            buttons = sdl_read_buttons(keys)
            game_update()
            sdl_compose(screen)
        }

        target u64 = zext[u64](tick) * 1000 / 60
        while zext[u64](SDL_GetTicks() - start) < target { SDL_Delay(1) }
    }
    return 0
}
