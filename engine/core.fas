const SCREEN_W i32 = 160
const SCREEN_H i32 = 96

var running bool = true
var tick i32 = 0
var frame_ticks i32 = 6

const BTN_UP i32 = 1
const BTN_DOWN i32 = 2
const BTN_RIGHT i32 = 4
const BTN_LEFT i32 = 8

const BTN_SPECIAL i32 = 16
const BTN_A1 i32 = 32

var buttons i32 = 0
var buttons_prev i32 = 0

const TEXT_COLS i32 = 40
const TEXT_ROWS i32 = 16

const PLANE_SLOTS usize = 16
const SPRITE_SLOTS usize = 2
const RECT_SLOTS usize = 16

struct Rect {
    x0 i32, y0 i32
    x1 i32, y1 i32
    color i32
    enable i32
}

struct Sprite {
    x0 i32, y0 i32                  // screen position of the top left texel
    id i32                          // sprite rom entry
    color i32                       // colors for texels 1, 2, 3 in bytes 0, 1, 2
    enable i32
    w i32                           // depth: hidden behind an occluding plane with a bigger den, 0 = never
}

struct Camera {
    px i32, py i32, pz i32
    r00 i32,    r01 i32,    r02 i32 // ray matrix
    r10 i32,    r11 i32,    r12 i32
    r20 i32,    r21 i32,    r22 i32
    k i32
    qs i32
    yaw i32
}

struct Plane {
    x0 i32, y0 i32                  // screen box
    x1 i32, y1 i32
    ea0 i32, eb0 i32, ec0 i32       // cut line 1: keep where ea*x + eb*y + ec >= 0
    ea1 i32, eb1 i32, ec1 i32       // cut line 2
    a i32, b i32, c i32, d i32      // screen mode: u = (ax+by+c)/den, v = (dx+ey+f)/den
    e i32, f i32, g i32, h i32, i i32 // den = gx+hy+i, bigger is nearer
    pattern i32                     // 0 solid .. 8 texture
    p0 i32, p1 i32, p2 i32          // far colors, bitmap bits, pattern scale
    sh i32                          // shade: level = den >> sh, 31 = no shading
    occlude i32                     // hides sprites behind it
    enable i32
    world i32                       // 0 screen mode, 1 world mode
    nx i32, ny i32, nz i32          // facing direction
    hh i32                          // position along that direction
    ux i32, uy i32, uz i32, u0 i32  // texture u across the world
    vx i32, vy i32, vz i32, v0 i32  // texture v across the world
    umax i32, vmax i32              // surface size in texture units, 0 = endless
    tex i32                         // rom texture for pattern 8
    lv0 i32, lv1 i32, lv2 i32       // colors for nearer shade levels
}

struct Gpu {
    bg i32
    planes arr[PLANE_SLOTS, Plane]
    sprites arr[SPRITE_SLOTS, Sprite]
    rects arr[RECT_SLOTS, Rect]
    text arr[640, i32]
    palette arr[256, i32]
    camera Camera
    video i32, video_palette i32
    text_fill i32, text_box i32
}

var gpu Gpu = {}

fn quit() void {
    running = false
}

fn btn(b i32) bool {
    return buttons & b != 0
}

fn pressed(b i32) bool {
    return buttons & ~buttons_prev & b != 0
}

fn released(b i32) bool {
    return buttons_prev & ~buttons & b != 0
}

// skips the store when the cell is unchanged. text_fill does not update gpu.text on the PC,
// so after a fill redraw what you need without relying on this
fn text_put(col i32, row i32, chr i32, fg i32, bg i32) void {
    if col < 0 || col >= TEXT_COLS || row < 0 || row >= TEXT_ROWS { return }
    word i32 = (chr & 255) | (fg & 255) << 8 | (bg & 255) << 16 | ((chr >> 8) & 1) << 24
    if gpu.text[row * TEXT_COLS + col] != word { gpu.text[row * TEXT_COLS + col] = word }
}

// takes NUL terminated string
fn text_print(col i32, row i32, str addr, fg i32, bg i32) void {
    i i32 = 0
    while str[u8, i] != 0 {
        text_put(col + i, row, zext[i32](str[u8, i]), fg, bg)
        i += 1
    }
}

// n in decimal starting at col, with a leading minus when negative. returns the width
fn text_number(col i32, row i32, n i32, fg i32, bg i32) i32 {
    digits arr[11, i32] = {}
    count i32 = 0
    m u32 = bitcast[u32](n)                 // unsigned, so -2147483648 negates in 32 bits
    if n < 0 { m = 0 - m }
    while true {
        digits[bitcast[u32](count)] = bitcast[i32](m % 10)
        count += 1
        m = m / 10
        if m == 0 { break }
    }
    width i32 = 0
    if n < 0 {
        text_put(col, row, 45, fg, bg)
        width = 1
    }
    for i i32 = count - 1; i >= 0; i -= 1 {
        text_put(col + width, row, 48 + digits[bitcast[u32](i)], fg, bg)
        width += 1
    }
    return width
}
