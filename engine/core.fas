const SCREEN_W i32 = 160
const SCREEN_H i32 = 96

var running bool = true
var tick i32 = 0

const BTN_UP i32 = 1
const BTN_DOWN i32 = 2
const BTN_RIGHT i32 = 4
const BTN_LEFT i32 = 8

const BTN_SPECIAL i32 = 16

const BTN_A i32 = 32
const BTN_B i32 = 64
const BTN_C i32 = 128
const BTN_D i32 = 256
const BTN_E i32 = 512
const BTN_F i32 = 1024
const BTN_G i32 = 2048
const BTN_H i32 = 4096
const BTN_I i32 = 8192
const BTN_J i32 = 16384

var buttons i32 = 0
var buttons_prev i32 = 0

const TEXT_COLS i32 = 40
const TEXT_ROWS i32 = 16

struct Rect {
    x0 i32, y0 i32
    x1 i32, y1 i32
    color i32
    enable i32
}

struct Sprite {
    x0 i32, y0 i32
    id i32
    color i32
    enable i32
    w i32
}

struct Camera {
    px i32, py i32, pz i32
    r00 i32,    r01 i32,    r02 i32 // ray matrix
    r10 i32,    r11 i32,    r12 i32
    r20 i32,    r21 i32,    r22 i32
    k i32
    qs i32
    yaw i32
}

struct Plane {
    x0 i32, y0 i32                  // screen box
    x1 i32, y1 i32
    ea0 i32, eb0 i32, ec0 i32       // cut line 1: keep where ea*x + eb*y + ec >= 0
    ea1 i32, eb1 i32, ec1 i32       // cut line 2
    a i32, b i32, c i32, d i32      // screen mode: u = (ax+by+c)/den, v = (dx+ey+f)/den
    e i32, f i32, g i32, h i32, i i32 // den = gx+hy+i, bigger is nearer
    pattern i32                     // 0 solid .. 8 texture
    p0 i32, p1 i32, p2 i32          // far colors, bitmap bits, pattern scale
    sh i32                          // shade: level = den >> sh, 31 = no shading
    occlude i32                     // hides sprites behind it
    enable i32
    world i32                       // 0 screen mode, 1 world mode
    nx i32, ny i32, nz i32          // facing direction
    hh i32                          // position along that direction
    ux i32, uy i32, uz i32, u0 i32  // texture u across the world
    vx i32, vy i32, vz i32, v0 i32  // texture v across the world
    umax i32, vmax i32              // surface size in texture units, 0 = endless
    tex i32                         // rom texture for pattern 8
    lv0 i32, lv1 i32, lv2 i32       // colors for nearer shade levels
}

struct Gpu {
    bg i32
    planes arr[16, Plane]
    sprites arr[2, Sprite]
    rects arr[16, Rect]
    text arr[640, i32]
    camera Camera
    video i32, video_palette i32
}

var gpu Gpu = {}
// backend snapshot. games write to gpu
var latched Gpu = {}

fn present() void {
    copy(latched, gpu)
}

fn quit() void {
    running = false
}

fn btn(b i32) bool {
    return buttons & b != 0
}

fn pressed(b i32) bool {
    return buttons & ~buttons_prev & b != 0
}

fn released(b i32) bool {
    return buttons_prev & ~buttons & b != 0
}

fn text_put(col i32, row i32, chr i32, color i32) void {
    if col < 0 || col >= TEXT_COLS || row < 0 || row >= TEXT_ROWS { return }
    word i32 = chr | color << 8
    if gpu.text[row * TEXT_COLS + col] != word { gpu.text[row * TEXT_COLS + col] = word }
}

// takes NUL terminated string
fn text_print(col i32, row i32, str addr, color i32) void {
    i i32 = 0
    while str[u8, i] != 0 {
        text_put(col + i, row, str[u8, i], color)
        i += 1
    }
}
