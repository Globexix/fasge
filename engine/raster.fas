use "C" <math.h>
use "core.fas"
use "font.fas"

const PIXELS usize = 160 * 96
const NOT_COVERED i32 = -2147483647 - 1

fn gdiv(n i32, d i32) i32 {
    if d == 0 { return 0 }
    if d == -1 { return 0 - n }
    return n / d
}

fn shr(x i32, s i32) i32 { return x >> (s & 31) }
fn shl(x i32, s i32) i32 { return x << (s & 31) }

fn clamp(x i32, lo i32, hi i32) i32 {
    return if x < lo { lo } else if x > hi { hi } else { x }
}

fn dot3(ax i32, ay i32, az i32, bx i32, by i32, bz i32) i32 {
    return ax * bx + ay * by + az * bz
}

var yaw_table arr[256, arr[4, i32]]

fn build_yaw_table() void {
    rs f64 = 20.0                           // round(2400 tan(fov / 2) / 80) at the default fov
    for a usize = 0; a < len(yaw_table); a += 1 {
        t f64 = 2.0 * M_PI * cvt[f64](a) / 256.0
        c f64 = cos(t)
        s f64 = sin(t)
        r00 i32 = cvt[i32](round(c * rs))
        r20 i32 = cvt[i32](round(-s * rs))
        yaw_table[a][0] = r00
        yaw_table[a][1] = cvt[i32](round(s * 2400.0)) - 80 * r00
        yaw_table[a][2] = r20
        yaw_table[a][3] = cvt[i32](round(c * 2400.0)) - 80 * r20
    }
}

var cam_r arr[3, arr[3, i32]]

fn camera_matrix() void {
    view c = latched.camera
    cam_r[0][0] = c.r00
    cam_r[0][1] = c.r01
    cam_r[0][2] = c.r02
    cam_r[1][0] = c.r10
    cam_r[1][1] = c.r11
    cam_r[1][2] = c.r12
    cam_r[2][0] = c.r20
    cam_r[2][1] = c.r21
    cam_r[2][2] = c.r22
    if c.yaw >= 1 && c.yaw <= 256 {
        view y = yaw_table[c.yaw - 1]
        cam_r[0][0] += y[0]
        cam_r[0][2] += y[1]
        cam_r[2][0] += y[2]
        cam_r[2][2] += y[3]
    }
}

// screen coefficients of a plane for this frame, derived from the camera in world mode
struct Derived {
    abc arr[3, i32]
    def arr[3, i32]
    ghi arr[3, i32]
    w i32
    u0 i32
    v0 i32
}

var derived arr[PLANE_SLOTS, Derived]
var active arr[PLANE_SLOTS, usize]
var active_count usize

fn prepare_plane(slot usize) void {
    view p = latched.planes[slot]
    view d = derived[slot]
    if p.world == 0 {
        d.abc[0] = p.a
        d.abc[1] = p.b
        d.abc[2] = p.c
        d.def[0] = p.d
        d.def[1] = p.e
        d.def[2] = p.f
        d.ghi[0] = p.g
        d.ghi[1] = p.h
        d.ghi[2] = p.i
        return
    }
    view c = latched.camera
    a i32 = p.hh - dot3(p.nx, p.ny, p.nz, c.px, c.py, c.pz)
    s i32 = if a < 0 { -1 } else { 1 }
    d.w = s * a
    for col usize = 0; col < 3; col += 1 {
        rx i32 = cam_r[0][col]
        ry i32 = cam_r[1][col]
        rz i32 = cam_r[2][col]
        d.ghi[col] = shl(s * dot3(p.nx, p.ny, p.nz, rx, ry, rz), c.k)
        d.abc[col] = shl(dot3(p.ux, p.uy, p.uz, rx, ry, rz), c.k)
        d.def[col] = shl(dot3(p.vx, p.vy, p.vz, rx, ry, rz), c.k)
    }
    d.u0 = dot3(p.ux, p.uy, p.uz, c.px, c.py, c.pz) + p.u0
    d.v0 = dot3(p.vx, p.vy, p.vz, c.px, c.py, c.pz) + p.v0
}

fn plane_texel(p addr, u i32, v i32) i32 {
    view pl = p[Plane]
    s i32 = pl.p2
    switch pl.pattern {
        case 1: return shr(u, s) & 1
        case 2: return (shr(u, s) ^ shr(v, s)) & 1
        case 3: {
            mask i32 = shl(1, s) - 1
            uu i32 = u + shl(shr(v, s) & 1, s)
            return if v & mask == 0 || uu & (2 * mask + 1) == 0 { 1 } else { 0 }
        }
        case 4: return shr(u, s) & 3
        case 5: return 2 * (shr(pl.p1, (shr(u, s) & 7) + 8 * (shr(v, s) & 3)) & 1)
        case 6, 7: return shr(pl.p1, (shr(u, s - 1) & 6) + 8 * (shr(v, s) & 3)) & 3
        case 8: {
            row usize = bitcast[u32](clamp(shr(v, s), 0, 15))
            word i32 = 0
            return shr(word, shr(u, s - 1) & 30) & 3
        }
        default: return 0
    }
}

var indices arr[PIXELS, u8]
var top_den arr[PIXELS, i32]
var top_occlude arr[PIXELS, bool]

fn compose_planes() void {
    camera_matrix()
    active_count = 0
    for slot usize = 0; slot < len(latched.planes); slot += 1 {
        if latched.planes[slot].enable == 0 { continue }
        prepare_plane(slot)
        active[active_count] = slot
        active_count += 1
    }
    bg u8 = trunc[u8](bitcast[u32](latched.bg) & 255)
    for y i32 = 0; y < SCREEN_H; y += 1 {
        for x i32 = 0; x < SCREEN_W; x += 1 {
            pixel usize = bitcast[u32](y * SCREEN_W + x)
            index u8 = bg
            best i32 = 0
            covered bool = false
            occlude bool = false
            for n usize = 0; n < active_count; n += 1 {
                view p = latched.planes[active[n]]
                if x < p.x0 || x > p.x1 || y < p.y0 || y > p.y1 { continue }
                if p.ea0 * x + p.eb0 * y + p.ec0 < 0 || p.ea1 * x + p.eb1 * y + p.ec1 < 0 { continue }
                view d = derived[active[n]]
                den i32 = d.ghi[0] * x + d.ghi[1] * y + d.ghi[2]
                u i32 = 0
                v i32 = 0
                if p.world != 0 {
                    den = gdiv(den, d.w)
                    if den <= 0 { continue }
                    u = d.u0 + gdiv(d.abc[0] * x + d.abc[1] * y + d.abc[2], den)
                    v = d.v0 + gdiv(d.def[0] * x + d.def[1] * y + d.def[2], den)
                    if p.umax > 0 && (u < 0 || u >= p.umax) { continue }
                    if p.vmax > 0 && (v < 0 || v >= p.vmax) { continue }
                } else {
                    if den == NOT_COVERED { continue }
                    u = gdiv(d.abc[0] * x + d.abc[1] * y + d.abc[2], den)
                    v = gdiv(d.def[0] * x + d.def[1] * y + d.def[2], den)
                }
                texel i32 = plane_texel(&p, u, v)
                if p.pattern == 7 && texel == 0 { continue }
                if covered && den < best { continue }
                level i32 = clamp(shr(den, p.sh), 0, 3)
                color i32 = if level == 0 { p.p0 } else if level == 1 { p.lv0 } else if level == 2 { p.lv1 } else { p.lv2 }
                index = trunc[u8](bitcast[u32](shr(color, 8 * texel)) & 255)
                best = den
                covered = true
                occlude = p.occlude != 0
            }
            indices[pixel] = index
            top_den[pixel] = best
            top_occlude[pixel] = covered && occlude
        }
    }
}

// 16 rows per sprite, texel k of a row at bits 2k. all zeros = invisible
var sprite_rom arr[64, arr[16, i32]]

// slot 0 pixels with enable >= 2, drawn again above rects and text
var raised_pixel arr[256, usize]
var raised_index arr[256, u8]
var raised_count usize

fn compose_sprites() void {
    raised_count = 0
    for slot usize = 0; slot < len(latched.sprites); slot += 1 {
        view s = latched.sprites[slot]
        if s.enable == 0 || s.id < 0 || s.id > 63 { continue }
        view rom = sprite_rom[bitcast[u32](s.id)]
        raised bool = slot == 0 && s.enable >= 2
        for cy i32 = 0; cy < 16; cy += 1 {
            y i32 = s.y0 + cy
            if y < 0 || y >= SCREEN_H { continue }
            for cx i32 = 0; cx < 16; cx += 1 {
                x i32 = s.x0 + cx
                if x < 0 || x >= SCREEN_W { continue }
                t i32 = (rom[bitcast[u32](cy)] >> (2 * cx)) & 3
                if t == 0 { continue }
                pixel usize = bitcast[u32](y * SCREEN_W + x)
                if s.w > 0 && top_occlude[pixel] && top_den[pixel] > s.w { continue }
                index u8 = trunc[u8](bitcast[u32](s.color >> (8 * (t - 1))) & 255)
                indices[pixel] = index
                if raised {
                    raised_pixel[raised_count] = pixel
                    raised_index[raised_count] = index
                    raised_count += 1
                }
            }
        }
    }
}

fn compose_rects() void {
    for slot usize = 0; slot < len(latched.rects); slot += 1 {
        view rect = latched.rects[slot]
        if rect.enable == 0 { continue }
        color u8 = trunc[u8](bitcast[u32](rect.color) & 255)
        for y i32 = clamp(rect.y0, 0, SCREEN_H); y <= clamp(rect.y1, -1, SCREEN_H - 1); y += 1 {
            for x i32 = clamp(rect.x0, 0, SCREEN_W); x <= clamp(rect.x1, -1, SCREEN_W - 1); x += 1 {
                indices[bitcast[u32](y * SCREEN_W + x)] = color
            }
        }
    }
}

fn compose_text() void {
    for y i32 = 0; y < SCREEN_H; y += 1 {
        for x i32 = 0; x < SCREEN_W; x += 1 {
            cell i32 = latched.text[(y / 6) * TEXT_COLS + x / 4]
            ch i32 = (cell & 255) | ((cell >> 16) & 256)
            if ch == 0 || ch >= bitcast[i32](trunc[u32](len(GLYPH_FG))) { continue }
            bit i32 = (y % 6) * 4 + x % 4
            px i32 = ((GLYPH_FG[ch] >> bit) & 1) | (((GLYPH_BG[ch] >> bit) & 1) << 1)
            if px == 0 { continue }
            color i32 = if px == 1 { cell >> 8 } else { cell >> 16 }
            indices[bitcast[u32](y * SCREEN_W + x)] = trunc[u8](bitcast[u32](color) & 255)
        }
    }
}

// palette indices of the whole screen into indices
fn compose() void {
    compose_planes()
    compose_sprites()
    compose_rects()
    compose_text()
    for n usize = 0; n < raised_count; n += 1 {
        indices[raised_pixel[n]] = raised_index[n]
    }
}
